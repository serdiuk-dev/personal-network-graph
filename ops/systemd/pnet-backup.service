[Unit]
Description=PNet private PostgreSQL and contact media backup
Requires=docker.service
After=docker.service pnet-backup-recovery.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/pnet-backup/backup.py
ExecStopPost=/usr/bin/python3 /usr/local/lib/pnet-backup/backup.py --recover
TimeoutStartSec=20min
TimeoutStopSec=240
KillMode=control-group
StandardOutput=journal
StandardError=journal
