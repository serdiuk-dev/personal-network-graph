generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NetworkCircle {
  INNER
  MIDDLE
  OUTER
}

model Person {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String?
  nickname   String?
  email      String?
  phone      String?
  company    String?
  position   String?
  city       String?
  country    String?
  notes      String?
  importance    Int           @default(1)
  networkCircle NetworkCircle @default(MIDDLE)
  primaryTag    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categories      PersonCategory[]
  interests       PersonInterest[]
  contactChannels ContactChannel[]

  outgoingRelationships Relationship[] @relation("RelationshipFrom")
  incomingRelationships Relationship[] @relation("RelationshipTo")
}

model Relationship {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  type      String?
  strength    Int      @default(1)
  notes       String?
  visualColor String?
  visualWidth Float?
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  from Person @relation("RelationshipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Person @relation("RelationshipTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  people PersonCategory[]
}

model Interest {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  people PersonInterest[]
}

model PersonCategory {
  personId   String
  categoryId String

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([personId, categoryId])
}

model PersonInterest {
  personId   String
  interestId String

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([personId, interestId])
}


enum ContactPlatform {
  TELEGRAM
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  MESSENGER
  EMAIL
  WHATSAPP
  SIGNAL
  VIBER
  PHONE
  OTHER
}

model ContactChannel {
  id          String          @id @default(uuid())
  personId    String
  platform    ContactPlatform
  handle            String?
  address           String?
  externalId        String?
  profileUrl        String?
  isPreferred       Boolean         @default(false)
  priority          Int             @default(100)
  isActive          Boolean         @default(true)
  automationAllowed Boolean         @default(false)
  notes             String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([platform])
  @@index([personId, priority])
  @@index([platform, externalId])
}


model GraphStyleSettings {
  id Int @id @default(1)

innerRingColor   String @default("#7dd3fc")
  innerRingOpacity Float  @default(0.42)
  innerRingWidth   Float  @default(1.40)

  middleRingColor   String @default("#7dd3fc")
  middleRingOpacity Float  @default(0.30)
  middleRingWidth   Float  @default(1.20)

  outerRingColor   String @default("#7dd3fc")
  outerRingOpacity Float  @default(0.20)
  outerRingWidth   Float  @default(1.00)

  innerEgoColor   String @default("#9bded9")
  innerEgoOpacity Float  @default(0.72)
  innerEgoWidth   Float  @default(0.85)

  middleEgoColor   String @default("#c7e0e8")
  middleEgoOpacity Float  @default(0.64)
  middleEgoWidth   Float  @default(0.60)

  outerEgoColor   String @default("#e1ebef")
  outerEgoOpacity Float  @default(0.75)
  outerEgoWidth   Float  @default(0.40)

  relationshipDefaultColor      String @default("#bfd6e3")
  relationshipDefaultOpacity    Float  @default(0.55)
  relationshipDefaultWidthScale Float  @default(1.00)

  relationshipFocusColor      String @default("#65b7e8")
  relationshipFocusOpacity    Float  @default(0.92)
  relationshipFocusWidthScale Float  @default(1.00)

  relationshipInactiveColor   String @default("#e4ecef")
  relationshipInactiveOpacity Float  @default(0.65)
  relationshipInactiveWidth   Float  @default(0.45)

  updatedAt DateTime @updatedAt
}
